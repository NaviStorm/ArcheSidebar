{
  "manifest_version": 2,
  "name": "NewArche",
  "version": "1.0.0",
  "description": "Ajoute un volet latéral personnalisable avec barre d'URL, favoris et gestion des onglets.",
  
  "icons": {
    "48": "icons/toto.svg",
    "96": "icons/toto.svg"
  },

  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "theme", 
    "https://www.google.com/s2/favicons*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "sidebar_action": {
    "default_icon": "icons/toto.svg",
    "default_title": "Ouvrir NewArche",
    "default_panel": "sidebar.html"
  },
  
  "browser_action": {
    "default_icon": "icons/toto.svg",
    "default_title": "Afficher/Masquer le volet NewArche"
  }
}